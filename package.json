{
  "name": "viveiro",
  "version": "0.42.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "test": "node --test tests/*.test.mjs",
    "evaluate:forecast": "node scripts/evaluate-forecasts.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json",
    "build:public": "node scripts/build-public-release.ts",
    "experiment": "node scripts/run-experiment.ts",
    "sweep": "node scripts/run-sweep.ts",
    "sensitivity": "node scripts/run-sensitivity.ts"
  },
  "dependencies": {
    "@stdlib/math-base-special-atan": "0.2.4",
    "@stdlib/math-base-special-atan2": "0.3.1",
    "@stdlib/math-base-special-cbrt": "0.2.3",
    "@stdlib/math-base-special-cos": "0.3.1",
    "@stdlib/math-base-special-exp": "0.2.5",
    "@stdlib/math-base-special-expm1": "0.2.4",
    "@stdlib/math-base-special-hypot": "0.2.4",
    "@stdlib/math-base-special-ln": "0.2.5",
    "@stdlib/math-base-special-log1p": "0.2.4",
    "@stdlib/math-base-special-pow": "0.3.1",
    "@stdlib/math-base-special-sin": "0.3.1",
    "@stdlib/math-base-special-tan": "0.3.1",
    "@stdlib/math-base-special-tanh": "0.2.4",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@babel/parser": "8.1.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.170.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "license": "MIT"
}
